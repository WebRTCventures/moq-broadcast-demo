# Workaround for an npm arborist bug (npm/cli#8261) that crashes dependency
# resolution with "Cannot read properties of null (reading 'edgesOut')" while
# loading vitest 4.x's optional peer set on npm 10.9.x. legacy-peer-deps skips
# the peer-set traversal that triggers the crash. Safe here: this is a leaf
# project with no peer-dependency expectations of its own.
legacy-peer-deps=true
